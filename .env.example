# Copy to .env and fill in to use a real model. With none set, AgentShield runs offline
# with a deterministic stand-in model (see README).

# anthropic | openai | ollama | offline
LLM_PROVIDER=offline

# Model override (defaults: anthropic=claude-sonnet-5-5, openai=gpt-4o-mini, ollama=llama3.1)
# LLM_MODEL=claude-sonnet-5-5

# Credentials (never commit real keys)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OLLAMA_HOST=http://localhost:11434
